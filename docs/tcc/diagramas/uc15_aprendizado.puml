@startuml
!include estilo.iuml
mainframe uc Máquina de aprendizado
left to right direction
actor Candidato as C
actor Empresa as E
actor Administrador as A
rectangle "Conecta Vagas DF" {
  usecase "Revisar e salvar\numa extração" as R
  usecase "Aprender com a revisão\n(lição + prova)" as AP
  usecase "Recalibrar a confiança\n(a cada 10 lições)" as RC
  usecase "Estudar o histórico\n(uma vez por dia, ao\nabrir o painel)" as ES
  usecase "Consultar lições,\nprovas e acertos" as CL
  usecase "Esquecer uma lição" as EL
}
C -- R
E -- R
A -- R
A -- ES
A -- CL
A -- EL
R ..> AP : <<include>>
AP ..> RC : <<include>>
ES ..> RC : <<include>>
@enduml
