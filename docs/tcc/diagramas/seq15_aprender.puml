@startuml
!include estilo.iuml
mainframe sd Aprender com a revisão
autonumber "0:"
hide footbox

actor Empresa as E
boundary ":TelaVagas" as T
control ":EmpresaController" as C
control ":MaquinaAprendizado" as M
control ":CorrecaoHumana" as H
control ":NaiveBayes" as N
entity ":AprendizadoDAO" as D
E -> T ++ : salvar a vaga revisada
T -> C ++ : vagas(acao = salvar, dados, sugestão)
C -> M ++ : aprenderDaRevisao(sugestão, salvo, usuarioId)
M -> H ++ : licoesDeLinhas() / conferirCampos()
H --> M -- : lições e acertos
M -> D ++ : registrarProva(modelo, acertou)
D --> M --
M -> N ++ : aprender(palavras, classe)
N --> M --
M -> D ++ : registrarExemplo() / registrarRevisao()
D --> M --
M -> M : calibrarSeNecessario(modelo)
M --> C -- : resumo do que aprendeu
C --> T -- : "Vaga publicada"
T --> E -- : exibir mensagem
@enduml
